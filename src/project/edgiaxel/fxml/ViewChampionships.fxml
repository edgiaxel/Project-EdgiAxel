<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="project.edgiaxel.controller.ViewChampionshipsController">
    <children>
        <Label layoutX="14.0" layoutY="14.0" text="CHAMPIONSHIP STANDINGS &amp; RACE RESULTS" textFill="#e50f0f">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Button layoutX="886.0" layoutY="16.0" mnemonicParsing="false" onAction="#handleResetSeason" style="-fx-background-color: #404040; -fx-text-fill: white;" text="RESET SEASON" />
        <Button layoutX="1019.0" layoutY="17.0" mnemonicParsing="false" onAction="#handleBackToDashboard" style="-fx-background-color: #404040; -fx-text-fill: white;" text="&lt; BACK TO DASHBOARD" />
        
        <HBox alignment="CENTER_LEFT" layoutX="14.0" layoutY="60.0" spacing="30.0" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="60.0">
            <children>
                <Label text="SELECT SEASON:" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="yearComboBox" onAction="#handleYearSelection" prefWidth="120.0" promptText="Select Year" style="-fx-text-fill: #fffff;" />
               
                <Label text="SELECT CIRCUIT (RACE RESULTS):" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="circuitComboBox" onAction="#handleCircuitSelection" prefWidth="250.0" promptText="Select Circuit" style="-fx-text-fill: WHITE;" />
                <Label fx:id="statusLabel" text="Status" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </HBox>
        
        <TabPane fx:id="championshipTabPane" layoutX="14.0" layoutY="100.0" prefHeight="685.0" prefWidth="1172.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="100.0">
            <tabs>
                <Tab text="DRIVERS STANDINGS (OVERALL)">
                    <TableView fx:id="driversOverallTable" style="-fx-background-color: #3b3b3b; -fx-control-inner-background: #1c1c1c;" />
                </Tab>
                <Tab text="OVERALL TEAM STANDINGS">
                    <TableView fx:id="overallTable" style="-fx-background-color: #3b3b3b; -fx-control-inner-background: #1c1c1c;" />
                </Tab>
                <Tab text="MANUFACTURERS">
                    <TableView fx:id="manufacturersTable" style="-fx-background-color: #3b3b3b; -fx-control-inner-background: #1c1c1c;" />
                </Tab>
                <Tab text="HYPERCAR TEAMS">
                    <TableView fx:id="teamHyperTable" style="-fx-background-color: #3b3b3b; -fx-control-inner-background: #1c1c1c;" />
                </Tab>
                <Tab text="LMGT3 TEAMS">
                    <TableView fx:id="teamGT3Table" style="-fx-background-color: #3b3b3b; -fx-control-inner-background: #1c1c1c;" />
                </Tab>
                <Tab fx:id="raceResultsTab" text="RACE RESULT DETAILS" />
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
